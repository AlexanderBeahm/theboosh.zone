#!/usr/bin/env perl

use strict;
use warnings;

use FindBin;
BEGIN { unshift @INC, "$FindBin::Bin/../lib" }

use HelloPerld::Database::Postgres;
use Digest::SHA qw(sha256_hex);
use Bytes::Random::Secure qw(random_bytes);
use Crypt::Bcrypt qw(bcrypt);

# Get environment variables
my $username = $ENV{'ADMIN_USERNAME'} || 'admin';
my $password = $ENV{'ADMIN_PASSWORD'};

# Validate required environment variables
unless ($password) {
    die "ERROR: ADMIN_PASSWORD environment variable is required\n";
}

# Validate password strength (minimum 8 characters)
if (length($password) < 8) {
    die "ERROR: Password must be at least 8 characters long\n";
}

print "Updating password for admin user: $username\n";

# Get database connection
my $dbh = HelloPerld::Database::Postgres::get_connection();
unless ($dbh) {
    die "ERROR: Could not connect to database\n";
}

eval {
    # Check if admin user exists
    my $check_sql = "SELECT id FROM admin_users WHERE username = ?";
    my $check_sth = $dbh->prepare($check_sql);
    $check_sth->execute($username);

    my $user = $check_sth->fetchrow_hashref();
    $check_sth->finish(); # Properly finish statement handle before disconnect

    unless ($user) {
        die "ERROR: Admin user '$username' does not exist\n";
    }

    my $user_id = $user->{id};
    print "Found admin user with ID: $user_id\n";

    # Hash the password using the same method as Auth controller
    my $password_hash = hash_password($password);

    # Update password
    my $update_sql = "UPDATE admin_users SET password_hash = ? WHERE id = ?";
    my $update_sth = $dbh->prepare($update_sql);
    $update_sth->execute($password_hash, $user_id);
    $update_sth->finish(); # Properly finish statement handle before disconnect

    print "✅ Admin password updated successfully!\n";
    print "You can now log in with:\n";
    print "  Username: $username\n";
    print "  Password: [from ADMIN_PASSWORD env var]\n";

    $dbh->disconnect();
};

if ($@) {
    print "❌ Failed to update admin password: $@\n";
    $dbh->disconnect() if $dbh;
    exit 1;
}

sub hash_password {
    my ($password) = @_;

    # Use bcrypt with cost factor 12 (same as Auth controller)
    return bcrypt($password, '2b', 12, random_bytes(16));
}

__END__

=head1 NAME

update_admin_password - Update admin user password

=head1 SYNOPSIS

    ADMIN_USERNAME=admin ADMIN_PASSWORD=newpassword perl script/update_admin_password

=head1 DESCRIPTION

This script updates the password for an existing admin user. It uses the same
password hashing method as the Auth controller to ensure compatibility.

=head1 ENVIRONMENT VARIABLES

=over 4

=item * ADMIN_USERNAME - Admin username (default: 'admin')

=item * ADMIN_PASSWORD - New admin password (required, minimum 8 characters)

=back

=head1 AUTHOR

Alex Beahm <alexanderbeahm@gmail.com>

=cut
