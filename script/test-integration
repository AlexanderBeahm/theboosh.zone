#!/usr/bin/env perl

use strict;
use warnings;
use FindBin;
use Cwd 'abs_path';

# Get the project root directory
my $project_root = abs_path("$FindBin::Bin/..");

# Change to project root
chdir $project_root or die "Cannot chdir to $project_root: $!";

# Run integration tests only
print "Running integration tests...\n";
print "=" x 60 . "\n";
print "Note: Integration tests require database connectivity\n";
print "=" x 60 . "\n\n";

my @prove_args = (
     '-l',              # Add lib/ to path
     '-r',              # Recursive
     '-v',              # Verbose
     't/integration/',  # Integration tests only
 );

 # Add color if terminal supports it
if (-t STDOUT) {
     push @prove_args, '--color';
}

 # Execute prove
exec('prove', @prove_args) or die "Cannot execute prove: $!";
