#!/usr/bin/env node

/**
 * CSP Configuration Generator
 *
 * Reads trusted embed domains from config/trusted-embed-domains.json
 * and generates configuration files for:
 * - Frontend (JavaScript array for validation)
 * - Backend (Perl CSP configuration)
 * - Nginx (production and staging configs with CSP headers)
 *
 * This ensures all three layers use the same trusted domain list,
 * preventing configuration drift and maintenance issues.
 */

const fs = require('fs');
const path = require('path');

// Configuration
const CONFIG_FILE = path.join(__dirname, '..', 'config', 'trusted-embed-domains.json');
const FRONTEND_OUTPUT = path.join(__dirname, '..', 'frontend', 'src', 'generated', 'trusted-domains.js');
const BACKEND_OUTPUT = path.join(__dirname, '..', 'config', 'generated', 'csp-frame-src.conf');
const NGINX_PRODUCTION_TEMPLATE = path.join(__dirname, '..', 'nginx', 'templates', 'production.conf.template');
const NGINX_STAGING_TEMPLATE = path.join(__dirname, '..', 'nginx', 'templates', 'staging.conf.template');
const NGINX_PRODUCTION_OUTPUT = path.join(__dirname, '..', 'nginx', 'generated', 'production.conf');
const NGINX_STAGING_OUTPUT = path.join(__dirname, '..', 'nginx', 'generated', 'staging.conf');

/**
 * Load and parse the trusted embed domains configuration
 */
function loadTrustedDomains() {
    try {
        const configContent = fs.readFileSync(CONFIG_FILE, 'utf8');
        const config = JSON.parse(configContent);
        return config;
    } catch (error) {
        console.error(`Error reading configuration file ${CONFIG_FILE}:`, error.message);
        process.exit(1);
    }
}

/**
 * Build flat array of all domain variants for frontend validation
 */
function buildDomainList(config) {
    const domains = [];

    for (const domainConfig of config.domains) {
        // Add the base domain
        domains.push(domainConfig.domain);

        // Add all variants
        if (domainConfig.variants && Array.isArray(domainConfig.variants)) {
            domains.push(...domainConfig.variants);
        }
    }

    return domains;
}

/**
 * Build CSP frame-src directive string for backend/nginx
 */
function buildCSPFrameSrc(config) {
    const sources = [];

    for (const domainConfig of config.domains) {
        const protocols = domainConfig.protocols || ['https'];

        for (const protocol of protocols) {
            // Add base domain
            sources.push(`${protocol}://${domainConfig.domain}`);

            // Add subdomain wildcard if enabled
            if (domainConfig.subdomains) {
                sources.push(`${protocol}://*.${domainConfig.domain}`);
            }

            // Add all variants
            if (domainConfig.variants && Array.isArray(domainConfig.variants)) {
                for (const variant of domainConfig.variants) {
                    sources.push(`${protocol}://${variant}`);
                }
            }
        }
    }

    return sources.join(' ');
}

/**
 * Ensure directory exists, create if necessary
 */
function ensureDirectoryExists(filePath) {
    const dir = path.dirname(filePath);
    if (!fs.existsSync(dir)) {
        fs.mkdirSync(dir, { recursive: true });
        console.log(`Created directory: ${dir}`);
    }
}

/**
 * Generate frontend JavaScript file
 */
function generateFrontendConfig(config, domainList) {
    const timestamp = new Date().toISOString();
    const content = `// AUTO-GENERATED FILE - DO NOT EDIT MANUALLY
// Generated on: ${timestamp}
// Source: config/trusted-embed-domains.json
// Generator: script/generate-csp-configs

/**
 * Trusted embed domains for iframe validation
 *
 * This array is used by MarkdownRenderer.vue to validate iframe sources
 * before allowing them to be embedded in markdown content.
 *
 * @type {string[]}
 */
export const TRUSTED_EMBED_DOMAINS = ${JSON.stringify(domainList, null, 4)};

/**
 * Configuration metadata
 */
export const TRUSTED_DOMAINS_CONFIG = {
    version: "${config.version}",
    lastUpdated: "${config.last_updated}",
    generatedAt: "${timestamp}",
    totalDomains: ${domainList.length}
};
`;

    ensureDirectoryExists(FRONTEND_OUTPUT);
    fs.writeFileSync(FRONTEND_OUTPUT, content, 'utf8');
    console.log(`Generated frontend config: ${FRONTEND_OUTPUT}`);
}

/**
 * Generate backend Perl configuration
 */
function generateBackendConfig(config, cspFrameSrc) {
    const timestamp = new Date().toISOString();
    const content = `# AUTO-GENERATED FILE - DO NOT EDIT MANUALLY
# Generated on: ${timestamp}
# Source: config/trusted-embed-domains.json
# Generator: script/generate-csp-configs

# CSP frame-src directive for trusted embed domains
# This variable is used by lib/HelloPerld.pm in the CSP header construction
our $CSP_FRAME_SRC = "frame-src ${cspFrameSrc}";

# Configuration metadata
our $CSP_CONFIG_VERSION = "${config.version}";
our $CSP_CONFIG_GENERATED = "${timestamp}";

1; # Required for Perl module
`;

    ensureDirectoryExists(BACKEND_OUTPUT);
    fs.writeFileSync(BACKEND_OUTPUT, content, 'utf8');
    console.log(`Generated backend config: ${BACKEND_OUTPUT}`);
}

/**
 * Generate nginx configuration from template
 */
function generateNginxConfig(templateFile, outputFile, cspFrameSrc) {
    try {
        const template = fs.readFileSync(templateFile, 'utf8');
        const content = template.replace(/\{\{CSP_FRAME_SRC\}\}/g, cspFrameSrc);

        ensureDirectoryExists(outputFile);
        fs.writeFileSync(outputFile, content, 'utf8');
        console.log(`Generated nginx config: ${outputFile}`);
    } catch (error) {
        console.error(`Error processing nginx template ${templateFile}:`, error.message);
        process.exit(1);
    }
}

/**
 * Main execution function
 */
function main() {
    console.log('CSP Configuration Generator');
    console.log('===========================');

    // Load configuration
    console.log(`Loading configuration from: ${CONFIG_FILE}`);
    const config = loadTrustedDomains();
    console.log(`Loaded ${config.domains.length} trusted domain configurations`);

    // Build domain lists
    const domainList = buildDomainList(config);
    const cspFrameSrc = buildCSPFrameSrc(config);

    console.log(`Total domain variants: ${domainList.length}`);
    console.log(`CSP frame-src directive: frame-src ${cspFrameSrc}`);

    // Generate output files
    console.log('\nGenerating configuration files...');

    try {
        generateFrontendConfig(config, domainList);
        generateBackendConfig(config, cspFrameSrc);

        // Generate nginx configs (templates will be created next)
        if (fs.existsSync(NGINX_PRODUCTION_TEMPLATE)) {
            generateNginxConfig(NGINX_PRODUCTION_TEMPLATE, NGINX_PRODUCTION_OUTPUT, cspFrameSrc);
        } else {
            console.warn(`Nginx production template not found: ${NGINX_PRODUCTION_TEMPLATE}`);
        }

        if (fs.existsSync(NGINX_STAGING_TEMPLATE)) {
            generateNginxConfig(NGINX_STAGING_TEMPLATE, NGINX_STAGING_OUTPUT, cspFrameSrc);
        } else {
            console.warn(`Nginx staging template not found: ${NGINX_STAGING_TEMPLATE}`);
        }

        console.log('\n✅ Configuration generation completed successfully!');
        console.log('\nNext steps:');
        console.log('1. Update MarkdownRenderer.vue to import from generated/trusted-domains.js');
        console.log('2. Update HelloPerld.pm to require config/generated/csp-frame-src.conf');
        console.log('3. Update docker-compose files to use generated nginx configs');

    } catch (error) {
        console.error('Error generating configuration files:', error.message);
        process.exit(1);
    }
}

// Run the script
if (require.main === module) {
    main();
}

module.exports = {
    loadTrustedDomains,
    buildDomainList,
    buildCSPFrameSrc,
    generateFrontendConfig,
    generateBackendConfig,
    generateNginxConfig
};