        "@vue/test-utils": "^2.4.6",
        "eslint": "^9.36.0",
        "eslint-plugin-vue": "^10.5.0",
        "happy-dom": "^20.0.8",
        "jsdom": "^27.0.0",
        "terser": "^5.44.0",
