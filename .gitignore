# Environment files (keep only examples in repo)
.env
.env.local
.env.development
.env.test
.env.staging
.env.production
.env.*.local

# Keep example files
!.env.*.example

# Frontend environment files
frontend/.env
frontend/.env.local
frontend/.env.*.local

# Allow frontend mode-specific environment files (no secrets, just API URLs)
!frontend/.env.development
!frontend/.env.staging
!frontend/.env.production

.continue/*
Makefile
MYMETA.json
MYMETA.yml
.claude/*.config

# Perl build artifacts
blib/
pm_to_blib

# Testing artifacts
coverage/

# Frontend build artifacts
frontend/node_modules/
frontend/dist/
lib/HelloPerld/Public/dist/

# Generated CSP configuration files (created by script/generate-csp-configs)
config/generated/
frontend/src/generated/
nginx/generated/

# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# IDE
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
