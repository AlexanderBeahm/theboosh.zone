# TheBoosh.Zone - Development Environment Template
# Copy this file to .env and fill in your actual values

# PostgreSQL Configuration
POSTGRES_DB=thebooshzone_dev
POSTGRES_USER=theboosh_user
POSTGRES_PASSWORD=your_secure_database_password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Database Connection Settings
DB_RETRY_ATTEMPTS=30    # Maximum retry attempts (default: 30)
DB_RETRY_INTERVAL=5     # Seconds between retries (default: 5)

# Admin User Configuration
ADMIN_USERNAME=admin
ADMIN_EMAIL=your_email@example.com
ADMIN_PASSWORD=your_secure_admin_password

# Grafana Configuration
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin_password
GF_DATABASE_NAME=grafana

# Prometheus Configuration
PROMETHEUS_RETENTION_TIME=200h

# Application Environment
NODE_ENV=development

# Media Upload Configuration (Optional - defaults provided)
# UPLOADS_DIR=/usr/src/hello-perld/uploads
# UPLOAD_MAX_SIZE=5242880
# UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,image/gif,image/webp,image/svg+xml

# Session Security (Generate with: openssl rand -hex 32)
# SESSION_SECRET=your_32_character_hex_session_secret_here